# Public URL promoters open (must match exactly, it is used for CSRF checks).
APP_URL=https://promoters.example.com

# Read-only role from sql/readonly-role.sql. Add ?sslmode=require for managed databases.
HIEVENTS_DATABASE_URL=postgres://promoter_stats:change-me@db-host:5432/hi-events

# First admin, created on startup if that email does not exist yet. This account can also sign in with
# the password, as a way in if email stops working. Everyone else signs in with emailed links.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=pick-a-long-password

# Default commission paid to promoters, as a percentage of sales after promo codes and discounts,
# before taxes and fees, minus refunds. Can be overridden per promoter in the admin.
COMMISSION_PERCENT=10

# Outgoing email for sign-in links. You can reuse the SMTP account Hi.Events sends with.
# Use port 587 with SMTP_SECURE=false (STARTTLS, required by the app on that port).
# Avoid port 465 (SMTP_SECURE=true): under Bun the server's greeting can arrive before the mail
# library listens for it, and about 40% of sends then fail with "Greeting never received".
# If SMTP_HOST is empty, links are printed to the container log instead (testing only).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Promoter stats <promoters@example.com>

# How long links stay valid: requested from the sign-in page (minutes), sent by an admin (days).
LOGIN_LINK_MINUTES=30
INVITE_LINK_DAYS=7

# Only show events from these Hi.Events account ids (comma separated). Leave empty for all accounts.
HIEVENTS_ACCOUNT_IDS=

# Set to false only when testing over plain http on a non-localhost address.
COOKIE_SECURE=true

# Port on the host.
HOST_PORT=3000
